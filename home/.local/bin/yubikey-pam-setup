#!/usr/bin/env bash
# Setup YubiKey U2F authentication for PAM (sudo, login, etc.)
# Requires: pam-u2f, pamu2fcfg packages

set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info()  { echo -e "${GREEN}[INFO]${NC} $1"; }
warn()  { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

YUBICO_DIR="${HOME}/.config/Yubico"
U2F_KEYS="${YUBICO_DIR}/u2f_keys"
PAM_DIR="/etc/pam.d"
# Services to enable the YubiKey for, the ones not installed are skipped.
PAM_SERVICES=(sudo swaylock lightdm login)
# First line pulling in the password stack: "@include common-auth" on
# Debian, "auth include|substack system-auth" on Fedora. The pam_u2f line
# must sit right before it.
PAM_ANCHOR='^(@include[[:space:]]+common-auth|auth[[:space:]]+(include|substack)[[:space:]])'

# Print the command installing the given packages, apt or dnf flavoured.
install_hint() {
    local apt_pkgs="$1" dnf_pkgs="$2"
    if command -v apt-get &>/dev/null; then
        echo "sudo apt install ${apt_pkgs}"
    else
        echo "sudo dnf install ${dnf_pkgs}"
    fi
}

check_dependencies() {
    info "Checking dependencies..."
    if ! command -v pamu2fcfg &>/dev/null; then
        error "pamu2fcfg not found. Install with: $(install_hint "libpam-u2f pamu2fcfg" "pam-u2f pamu2fcfg")"
    fi
    if ! command -v ykman &>/dev/null; then
        warn "ykman not found. Install with: $(install_hint "yubikey-manager" "yubikey-manager")"
    fi
}

check_yubikey() {
    info "Checking for YubiKey..."
    if ! lsusb -d 1050: &>/dev/null; then
        error "No YubiKey detected. Please insert your YubiKey and try again."
    fi
    info "YubiKey detected."
}

generate_u2f_keys() {
    mkdir -p "${YUBICO_DIR}"

    if [[ -f "${U2F_KEYS}" ]]; then
        warn "Existing u2f_keys found at ${U2F_KEYS}"
        read -rp "Add another key (a) or overwrite (o)? [a/o]: " choice
        case "${choice}" in
            a|A)
                info "Enter your FIDO2 PIN if asked, then touch your YubiKey when it blinks..."
                pamu2fcfg -n >> "${U2F_KEYS}"
                ;;
            o|O)
                info "Enter your FIDO2 PIN if asked, then touch your YubiKey when it blinks..."
                pamu2fcfg > "${U2F_KEYS}"
                ;;
            *)
                error "Invalid choice. Aborting."
                ;;
        esac
    else
        info "Generating u2f_keys. Enter your FIDO2 PIN if asked, then touch your YubiKey when it blinks..."
        pamu2fcfg > "${U2F_KEYS}"
    fi

    chmod 600 "${U2F_KEYS}"
    info "u2f_keys saved to ${U2F_KEYS}"
}

show_pam_instructions() {
    local hostname
    hostname=$(hostname)
    local pam_line="auth       sufficient   pam_u2f.so cue origin=pam://${hostname} appid=pam://${hostname}"
    local service file line_number
    local -a commands=()

    echo ""
    info "YubiKey registered. Now configure PAM."
    echo ""
    echo "WARNING: 'sufficient' before the password stack means a YubiKey"
    echo "touch ALONE satisfies authentication, replacing the password"
    echo "rather than augmenting it. A stolen laptop with the key inserted"
    echo "then unlocks with no secret. Use 'required' instead to demand"
    echo "both password and touch."
    echo ""

    for service in "${PAM_SERVICES[@]}"; do
        file="${PAM_DIR}/${service}"
        if [[ ! -r "${file}" ]]; then
            continue
        fi
        if grep -q 'pam_u2f\.so' "${file}"; then
            info "${file} already uses pam_u2f, skipping."
            continue
        fi
        line_number=$(grep -nE -m1 "${PAM_ANCHOR}" "${file}" | cut -d: -f1 || true)
        if [[ -z "${line_number}" ]]; then
            warn "No password stack line found in ${file}, add the line by hand."
            continue
        fi
        commands+=("sudo sed -i.bak '${line_number}i ${pam_line}' ${file}")
    done

    if (( ${#commands[@]} == 0 )); then
        info "Nothing left to configure."
        return
    fi

    echo "1. Open a root shell in ANOTHER terminal and keep it open, it is"
    echo "   your way back in if a PAM file ends up broken:"
    echo ""
    echo -e "  ${YELLOW}sudo -s${NC}"
    echo ""
    echo "2. Insert the pam_u2f line before the password stack of each"
    echo "   service (a .bak copy of every file is kept):"
    echo ""
    printf "  ${YELLOW}%s${NC}\n" "${commands[@]}"
    echo ""
    echo "3. Test in a NEW terminal, it should ask for a touch, not a password:"
    echo ""
    echo -e "  ${YELLOW}sudo -k; sudo true${NC}"
    echo ""
    echo "   Then lock the screen and unlock it with a touch."
    echo ""
    echo "4. To roll back a file, restore its copy from the root shell:"
    echo ""
    echo -e "  ${YELLOW}mv ${PAM_DIR}/sudo.bak ${PAM_DIR}/sudo${NC}"
    echo ""
    echo "Options of the pam_u2f line:"
    echo "  - 'sufficient': Falls back to password if YubiKey absent"
    echo "  - 'required': Always requires YubiKey (can lock you out)"
    echo "  - 'cue': Shows 'Please touch the device' prompt"
}

main() {
    echo "YubiKey PAM U2F Setup"
    echo "====================="
    echo ""

    check_dependencies
    check_yubikey
    generate_u2f_keys
    show_pam_instructions
}

main "$@"
