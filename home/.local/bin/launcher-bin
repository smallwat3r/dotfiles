#!/usr/bin/env bash
#
# launcher-bin - Custom command launcher
#
# Interactively select and run a command from PATH, desktop applications,
# or installed Flatpak apps (via their exported desktop files). Commands
# are sorted by usage frequency.
#
# Usage: launcher-bin
#
# Dependencies: fzf, gtk-launch (optional)
#
PATH="$HOME/.local/bin:$HOME/go/bin:$HOME/.cargo/bin:$PATH"
set -euo pipefail

. "${HOME}/.local/lib/launcher.sh"

require fzf

HISTORY_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/launcher-bin-history"
HISTORY_MAX_LINES=50

# Flatpak export dirs included so flatpaks list and launch as desktop apps
DESKTOP_DIRS=(
    /usr/share/applications
    "$HOME/.local/share/applications"
    /var/lib/flatpak/exports/share/applications
    "$HOME/.local/share/flatpak/exports/share/applications"
)

is_desktop() {
    local dir
    for dir in "${DESKTOP_DIRS[@]}"; do
        [[ -f "$dir/$1.desktop" ]] && return 0
    done
    return 1
}

trim_history() {
    [[ -f $HISTORY_FILE ]] || return 0
    local lines
    lines=$(wc -l < "$HISTORY_FILE")
    if (( lines > HISTORY_MAX_LINES )); then
        local tmp="${HISTORY_FILE}.tmp"
        tail -n "$HISTORY_MAX_LINES" "$HISTORY_FILE" > "$tmp" && mv "$tmp" "$HISTORY_FILE"
    fi
}

run() {
    echo "$1" >> "$HISTORY_FILE"
    trim_history
    if is_desktop "$1"; then
        # Pass the full file name: gtk-launch only appends ".desktop" when the
        # name lacks it, so an ID like com.bitwarden.desktop would otherwise
        # be looked up verbatim and not found.
        setsid gtk-launch "$1.desktop" >/dev/null 2>&1 &
    else
        setsid "$1" >/dev/null 2>&1 &
    fi
}

list_desktop_apps() {
    local dir f base
    for dir in "${DESKTOP_DIRS[@]}"; do
        [[ -d $dir ]] || continue
        for f in "$dir"/*.desktop; do
            [[ -f $f ]] || continue
            base="${f##*/}"
            echo "${base%.desktop}"
        done
    done
}

list_commands() {
    { compgen -c; list_desktop_apps; } | sort -u
}

sort_by_frequency() {
    if [[ -f $HISTORY_FILE ]]; then
        awk -v hist="$HISTORY_FILE" '
            BEGIN { while ((getline line < hist) > 0) freq[line]++ }
            !seen[$0]++ { print freq[$0]+0, $0 }
        ' | sort -rn | cut -d' ' -f2-
    else
        cat
    fi
}

trap "" HUP

target="$(list_commands | sort_by_frequency | fzf_pick)" || exit 0

[[ -n $target ]] && run "$target"
