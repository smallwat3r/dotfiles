#!/usr/bin/env bash
# Git credential helper using pass (password-store).
#
# Pass entry format (e.g., at git/github.com):
#   <password or token>
#   username: <username>
#
# Usage in git config:
#   [credential]
#       helper = git-credential-pass

set -euo pipefail

[[ "${1:-}" == "get" ]] || exit 0

host=$(grep "^host=" | cut -d= -f2-)
[[ -z "$host" ]] && exit 1

# Validate host to prevent path traversal attacks
if [[ "$host" =~ [/\\] ]] || [[ "$host" == *..* ]]; then
    exit 1
fi

content=$(pass show "git/$host" 2>/dev/null) || exit 1
password=$(grep -v -e '^$' -e '^username:' <<< "$content" | head -n1 || true)
username=$(sed -n 's/^username:[[:space:]]*//p' <<< "$content" | head -n1)

[[ -n "$username" ]] && printf 'username=%s\n' "$username"
[[ -n "$password" ]] && printf 'password=%s\n' "$password"
