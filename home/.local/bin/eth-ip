#!/usr/bin/env bash
# Print the IP of the device plugged into the laptop's ethernet port.
# The port is in NetworkManager shared mode (192.168.123.0/24), so the
# device shows up in the neighbour table once it has taken a DHCP lease.
# Usage: eth-ip [iface]   (default: the first wired port with carrier)
set -euo pipefail

# Physical ethernet ports only, veths and bridges have no backing device.
# Reading carrier fails on a port that is administratively down.
wired_iface_with_carrier() {
  local dev
  for dev in /sys/class/net/*; do
    [[ -e $dev/device && ! -d $dev/wireless ]] || continue
    [[ $(<"$dev/type") == 1 ]] || continue
    [[ $(cat "$dev/carrier" 2>/dev/null) == 1 ]] || continue
    echo "${dev##*/}"
    return
  done
  return 1
}

iface=${1:-$(wired_iface_with_carrier)} || {
  echo "Error: no wired port with carrier" >&2
  exit 1
}

# Neighbour entries and leases are caches, an unplugged device lingers
# there for hours, so only report candidates that answer a ping.
found=
for ip in $(
  { ip -4 neigh show dev "$iface" | awk '{print $1}'
    sudo -n awk '{print $3}' "/var/lib/NetworkManager/dnsmasq-$iface.leases" 2>/dev/null || true
  # Numeric order on the last octet, so leased devices (.1 to .213) come
  # before statically addressed gear above the pool, like the switch.
  } | sort -u -t. -k4,4n
); do
  ping -c1 -W1 -I "$iface" "$ip" >/dev/null 2>&1 && echo "$ip" && found=1
done

if [[ -z $found ]]; then
  echo "Error: no device found on $iface" >&2
  exit 1
fi
