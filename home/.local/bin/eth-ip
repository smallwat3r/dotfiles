#!/usr/bin/env bash
# Print the IP of the device plugged into the laptop's ethernet port.
# The port is in NetworkManager shared mode (192.168.123.0/24), so the
# device shows up in the neighbour table once it has taken a DHCP lease.
# Usage: eth-ip [iface]   (default: enp196s0)
set -euo pipefail

iface=${1:-enp196s0}

# Neighbour entries and leases are caches, an unplugged device lingers
# there for hours, so only report candidates that answer a ping.
found=
for ip in $(
  { ip -4 neigh show dev "$iface" | awk '{print $1}'
    sudo -n awk '{print $3}' "/var/lib/NetworkManager/dnsmasq-$iface.leases" 2>/dev/null || true
  } | sort -u
); do
  ping -c1 -W1 -I "$iface" "$ip" >/dev/null 2>&1 && echo "$ip" && found=1
done

if [[ -z $found ]]; then
  echo "Error: no device found on $iface" >&2
  exit 1
fi
