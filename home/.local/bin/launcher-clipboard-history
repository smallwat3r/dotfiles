#!/usr/bin/env bash
#
# launcher-clipboard-history - Browse and select from clipboard history
#
# Interactively select an entry from your clipboard history and copy
# it back to the clipboard.
#
# Dependencies: fzf, cliphist, wl-copy
#
set -euo pipefail

. "${HOME}/.local/lib/launcher.sh"

require fzf cliphist wl-copy

selected="$(cliphist list | fzf_pick_id)" || exit 0
[[ -z "$selected" ]] && exit 0

printf '%s' "$selected" | cliphist decode | wl-copy
