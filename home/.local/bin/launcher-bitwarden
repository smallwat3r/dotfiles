#!/usr/bin/env bash
#
# launcher-bitwarden - Bitwarden credential picker using rbw and fzf
#
# Interactively select a credential from your Bitwarden vault and copy
# a field (password, username, or TOTP) to the clipboard. The clipboard
# is automatically cleared after the first paste for security.
#
# Dependencies: rbw, fzf, jq, wl-copy/xclip
#
set -euo pipefail

. "${HOME}/.local/lib/launcher.sh"

require rbw fzf jq

history_file="${XDG_CACHE_HOME:-$HOME/.cache}/launcher-bitwarden-history"
history_max=50

load_history() {
    declare -gA history_rank
    [[ -f $history_file ]] || return
    local rank=1
    while IFS= read -r entry; do
        [[ -z ${history_rank[$entry]+x} ]] && history_rank[$entry]=$rank
        ((rank++))
    done < "$history_file"
}

clip_secret() {
    local content
    content=$(cat)
    printf '%s' "$content" | clip_secure
    # Drop it from the clipboard history. The match goes through a pipe so
    # the secret never appears in argv, after a pause for cliphist to store
    # it. Matched on the first line, cliphist previews are single line.
    if has cliphist; then
        sleep 0.5
        cliphist list | grep -F -f <(printf '%s\n' "$content" | grep -m1 .) \
            | cliphist delete >/dev/null 2>&1 || true
    fi
}

list_items() {
    load_history
    for i in "${!items[@]}"; do
        IFS=$'\t' read -r name user <<< "${items[$i]}"
        local entry="$name${user:+	$user}"
        local rank=${history_rank[$entry]:-999999}

        if [[ -n $user ]]; then
            printf '%s\t%d\t[login] %s (%s)\n' "$rank" "$i" "$name" "$user"
        else
            printf '%s\t%d\t[note]  %s\n' "$rank" "$i" "$name"
        fi
    done | sort -t$'\t' -k1,1n | cut -f2-
}

get_fields() {
    local name="$1" user="$2"
    local raw totp f

    raw="$(rbw get --raw "$name" ${user:+"$user"} 2>/dev/null)" || return
    # NUL-joined so multiline notes survive; f: password, username, notes, has_totp
    mapfile -d '' -t f < <(jq -j '[.data.password // "", .data.username // "",
        .notes // "", (.data.totp != null | tostring)] | join("\u0000")' <<< "$raw")

    [[ -n ${f[0]:-} ]] && fields[password]="${f[0]}" || true
    [[ -n ${f[1]:-} ]] && fields[username]="${f[1]}" || true
    [[ -n ${f[2]:-} ]] && fields[notes]="${f[2]}" || true
    if [[ ${f[3]:-} == "true" ]]; then
        totp="$(rbw code "$name" ${user:+"$user"} 2>/dev/null || true)"
        [[ -n $totp ]] && fields[totp]="$totp" || true
    fi
}

# Main

rbw unlocked 2>/dev/null || rbw unlock

mapfile -t items < <(rbw list --fields name,user)
(( ${#items[@]} )) || die "No items found in vault"

target="$(list_items | fzf_pick "rbw> " | cut -f1)" || exit 0
[[ -z $target ]] && exit 0

IFS=$'\t' read -r name user <<< "${items[$target]}"

declare -A fields
get_fields "$name" "$user"
(( ${#fields[@]} )) || die "No fields available"

if (( ${#fields[@]} == 1 )); then
    selected="${!fields[*]}"
else
    selected="$(printf '%s\n' "${!fields[@]}" | fzf_pick "field> ")" || exit 0
    [[ -z $selected ]] && exit 0
fi

printf '%s' "${fields[$selected]}" | clip_secret
history_push "$history_file" "$name${user:+	$user}" "$history_max"
