# Include host-specific configs
Include ~/.ssh/private
Include ~/.ssh/work

# Global defaults
Host *
  AddKeysToAgent yes
  IdentityFile ~/.ssh/id_yubikey
  IdentityFile ~/.ssh/id_rsa
  PreferredAuthentications publickey,keyboard-interactive,password
  # Keep connections alive
  ServerAliveInterval 60
  ServerAliveCountMax 3
  # Keep known_hosts readable for debugging
  HashKnownHosts no
  # Reuse connections: first connection becomes master, subsequent ones multiplex
  ControlMaster auto
  # Socket path for multiplexed connections (%r=user, %h=host, %p=port)
  ControlPath ~/.ssh/sockets/%r@%h-%p
  # Keep master connection alive for 10 minutes after last session closes
  ControlPersist 600

# GitHub
Host github.com
  User git
  # Fail fast and keep the connection alive during long pushes
  ConnectTimeout 10
  ServerAliveInterval 20
  GSSAPIAuthentication no

# Devices at home
Host pocket3 pocket4
  User smallwat3r
  Hostname %h-fedora

Host nas retropie gardener ha pi3a
  User pi

# Reached over mDNS on the LAN and over the tailnet elsewhere: the name is
# tried as <name>.local, then the tailnet domain. Typing the full name forces
# one route. Only nas, gardener and ha are published under ts.smallwat3r.com,
# the rest rely on MagicDNS.
Host nas gardener ha
  CanonicalizeHostname yes
  CanonicalDomains local ts.smallwat3r.com

Host retropie pi3a pocket3 pocket4
  CanonicalizeHostname yes
  CanonicalDomains local feist-corn.ts.net

# Local machines
Host robot
  User smallwat3r
  Hostname robot.local

Host mac
  User smallwat3r
  Hostname Matts-Macbook-Air-2.local

# Local VMs (port-forwarded)
Host vbox.*
  User smallwat3r
  Hostname 127.0.0.1

Host vbox.ubuntu20
  Port 3022

Host vbox.ubuntu22
  Port 3122

Host vmware.humble
  User smallwat3r
  Hostname 192.168.154.128

# Balena device tunnel
Host balena-tunnel
  User root
  Hostname localhost
  Port 22222

# Device plugged into the laptop's ethernet port, IP resolved by eth-ip
Host eth
  ProxyCommand nc "$(~/.local/bin/eth-ip | head -n1)" %p
