#!/usr/bin/env bash
# System info for waybar (JSON output with tooltip).

# CPU usage from /proc/stat, sampled over a short interval (a
# since-boot average is effectively a constant)
read -r _ u1 n1 s1 i1 w1 q1 sq1 st1 _ < /proc/stat
sleep 0.5
read -r _ u2 n2 s2 i2 w2 q2 sq2 st2 _ < /proc/stat
busy=$(( (u2 + n2 + s2 + q2 + sq2 + st2) - (u1 + n1 + s1 + q1 + sq1 + st1) ))
total=$(( busy + (i2 + w2) - (i1 + w1) ))
cpu=$(( total > 0 ? 100 * busy / total : 0 ))

# Memory
read -r mem mem_detail < <(
    free -h | awk '/Mem:/ { printf "%s %s / %s", $3, $3, $2 }'
)

# GPU memory (AMD)
gpu_used=$(head -1 /sys/class/drm/card*/device/mem_info_vram_used 2>/dev/null)
gpu_total=$(head -1 /sys/class/drm/card*/device/mem_info_vram_total 2>/dev/null)
if [[ -n "$gpu_used" && -n "$gpu_total" ]]; then
    gpu_detail=$(awk -v u="$gpu_used" -v t="$gpu_total" 'BEGIN {
        printf "%.1fGi / %.1fGi", u/1024/1024/1024, t/1024/1024/1024
    }')
else
    gpu_detail="N/A"
fi

# CPU temperature from hwmon (thermal_zone0 is not necessarily the CPU)
cpu_temp="N/A"
for hw in /sys/class/hwmon/hwmon*; do
    case "$(cat "$hw/name" 2>/dev/null)" in
        k10temp|coretemp|zenpower)
            cpu_temp="$(awk '{printf "%.0f°C", $1/1000}' "$hw"/temp1_input 2>/dev/null)"
            break
            ;;
    esac
done

# Temperature (all zones for tooltip)
temp_detail=""
for zone in /sys/class/thermal/thermal_zone*; do
    name=$(cat "$zone/type" 2>/dev/null)
    val=$(awk '{printf "%.0f", $1/1000}' "$zone/temp" 2>/dev/null)
    temp_detail+="$name: ${val}°C\\n"
done

# Disk
disk_detail=$(df -h / | awk 'NR==2 { printf "%s / %s", $3, $2 }')

# Build tooltip
tooltip="System Info\\n"
tooltip+="----------\\n"
tooltip+="cpu: ${cpu}% (${cpu_temp})\\n"
tooltip+="mem: ${mem_detail}\\n"
tooltip+="gpu: ${gpu_detail}\\n"
tooltip+="dsk: ${disk_detail}\\n"
tooltip+="\\n"
tooltip+="Temperature\\n"
tooltip+="----------\\n"
tooltip+="${temp_detail%\\n}"

# Output JSON
printf '{"text": " %s %s%% ", "tooltip": "%s"}' \
    "$mem" "$cpu" "$tooltip"
