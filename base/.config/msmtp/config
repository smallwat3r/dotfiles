## MSMTP configuration file
##
## Remember to run:
##   chmod 600

# Set default values for all following accounts.
defaults
auth           on
tls            on
logfile        ~/.msmtp.log

# personal
account        personal
host           smtp.gmail.com
port           587
from           mpetiteau.pro@gmail.com
user           mpetiteau.pro@gmail.com
passwordeval   "pass email/personal.gmail"

# sws
account        sws
