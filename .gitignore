__pycache__/
*.swp
*.swo
*.pyc
*.zwc
*.private
*.pem
*.pub
*.asc
*.key
id_rsa*
known_hosts
known_hosts.*

**/.gnupg/*
!**/.gnupg/gpg.conf
!**/.gnupg/gpg-agent.conf

**/.ssh/*
!**/.ssh/config

**/.config/nvim/*
!**/.config/nvim/init.vim

**/.config/sway/outputs
**/.config/sway/workspaces

**/.config/Yubico/*

# created by systemctl --user enable (~/.config/systemd is stowed)
**/systemd/user/*.wants/
