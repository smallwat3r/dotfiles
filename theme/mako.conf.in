# Mako notification daemon config

# Appearance (old school, matches sway theme)
font=Ocrab Nerd Font Mono 9
background-color=#{{face}}
text-color=#{{black}}
border-color=#{{navy}}
border-size=2
border-radius=0
progress-color=over #{{navy}}

# Positioning and layout
anchor=top-right
margin=10
padding=10
width=300
max-visible=5

# Auto-dismiss after 10 seconds
default-timeout=10000

# Left click to focus app, right click to dismiss
on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=dismiss-all

# Group notifications from the same app
group-by=app-name

# Show icons
icons=1
max-icon-size=48

# Critical notifications don't auto-dismiss
[urgency=critical]
ignore-timeout=1
background-color=#{{urgent}}
text-color=#{{white}}
border-color=#{{urgent}}

# Suppress raop_sink (AirPlay) notifications
[body~="raop_sink"]
invisible=1
